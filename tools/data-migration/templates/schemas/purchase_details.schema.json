{
  "name": "purchase_details",
  "title": "purchase · LineIn",
  "description": "Entidad LineIn de purchase. Mismo esquema en Silver y Gold.",
  "fields": [
    {
      "name": "purchase_detail_ref",
      "type": "string",
      "description": "Referencia local estable (clave del CSV). Se asigna una vez y no se recalcula.",
      "constraints": {
        "maxLength": 120,
        "unique": true,
        "required": true
      }
    },
    {
      "name": "sio_id",
      "type": "string",
      "description": "UUID existente en SIO, verificado por API. Vacío si aún no existe. Nunca inventado.",
      "format": "uuid"
    },
    {
      "name": "source_ref",
      "type": "string",
      "description": "Registro original del cliente: <archivo>#<hoja>#<fila> (varios separados por ' | '), CONTEXTO o DECISION:<id>.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "migration_status",
      "type": "string",
      "description": "PENDIENTE | VALIDADO | CONFLICTO. En Gold siempre VALIDADO.",
      "constraints": {
        "enum": [
          "PENDIENTE",
          "VALIDADO",
          "CONFLICTO"
        ],
        "required": true
      }
    },
    {
      "name": "status_reason",
      "type": "string",
      "description": "Motivo del estado (qué falta o qué conflicto existe)."
    },
    {
      "name": "purchase_ref",
      "type": "string",
      "description": "Compra",
      "constraints": {
        "maxLength": 120,
        "required": true
      }
    },
    {
      "name": "company_product_ref",
      "type": "string",
      "description": "Producto de empresa",
      "constraints": {
        "maxLength": 120,
        "required": true
      }
    },
    {
      "name": "company_product_presentation_ref",
      "type": "string",
      "description": "Presentación de empresa",
      "constraints": {
        "maxLength": 120
      }
    },
    {
      "name": "supplier_product_ref",
      "type": "string",
      "description": "Producto del proveedor",
      "constraints": {
        "maxLength": 120
      }
    },
    {
      "name": "quantity",
      "type": "number",
      "description": "Cantidad (> 0)",
      "constraints": {
        "minimum": 0,
        "required": true
      }
    },
    {
      "name": "unit_cost",
      "type": "number",
      "description": "Costo unitario real (vacío = dato faltante)",
      "constraints": {
        "minimum": 0,
        "required": true
      }
    },
    {
      "name": "discount_amount",
      "type": "number",
      "description": "Descuento",
      "constraints": {
        "minimum": 0
      }
    },
    {
      "name": "tax_amount",
      "type": "number",
      "description": "Impuesto",
      "constraints": {
        "minimum": 0
      }
    }
  ],
  "primaryKey": [
    "purchase_detail_ref"
  ],
  "missingValues": [
    ""
  ],
  "foreignKeys": [
    {
      "fields": [
        "purchase_ref"
      ],
      "reference": {
        "resource": "purchases",
        "fields": [
          "purchase_ref"
        ]
      }
    },
    {
      "fields": [
        "company_product_ref"
      ],
      "reference": {
        "resource": "company_products",
        "fields": [
          "company_product_ref"
        ]
      }
    },
    {
      "fields": [
        "company_product_presentation_ref"
      ],
      "reference": {
        "resource": "company_product_presentations",
        "fields": [
          "company_product_presentation_ref"
        ]
      }
    },
    {
      "fields": [
        "supplier_product_ref"
      ],
      "reference": {
        "resource": "supplier_products",
        "fields": [
          "supplier_product_ref"
        ]
      }
    }
  ],
  "uniqueKeys": [
    [
      "purchase_ref",
      "company_product_ref",
      "company_product_presentation_ref"
    ]
  ],
  "sio": {
    "service": "purchase",
    "endpoint": "POST /api/v1/companies/{company_id}/purchases (lines) · /purchases/{purchase_id}/details",
    "contract": "LineIn",
    "identity": [
      "purchase_ref",
      "company_product_ref",
      "company_product_presentation_ref"
    ],
    "rules": [
      {
        "type": "positive",
        "field": "quantity"
      }
    ],
    "verified_at": "2026-10-12 (OpenAPI publicado por el servicio); IUM: spec 018, 2026-10-13"
  }
}
