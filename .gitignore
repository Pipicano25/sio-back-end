# spec-kit / agente: no versionar credenciales que el agente pueda guardar aquí
.claude/settings.local.json

# Keycloak: el realm renderizado contiene el valor real de
# KEYCLOAK_TEST_USER_PASSWORD; solo se versiona la plantilla
# (sio-realm.template.json). Se regenera con:
#   infrastructure/scripts/render-realm.sh
infrastructure/keycloak/import/sio-realm.json

