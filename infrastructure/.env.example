# Nombres de proyecto compose: cada archivo los declara con "name:" (sio para
# la infraestructura, sio-<microservicio> para cada servicio). No definir
# COMPOSE_PROJECT_NAME aquí: forzaría el mismo proyecto para todos.

# Imágenes
POSTGRES_VERSION=17-alpine
KEYCLOAK_VERSION=26.7.0
RABBITMQ_VERSION=3.13-management-alpine
# Tag de las imágenes de los microservicios de SIO, construidas localmente
# desde services/<microservicio>/Dockerfile (constitución §1).
SIO_SERVICES_VERSION=0.1.0

# RabbitMQ
RABBITMQ_USER=sio_events
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# PostgreSQL por microservicio (una instancia independiente por servicio)
OPERATIONAL_CONTEXT_DB_NAME=operational_context
OPERATIONAL_CONTEXT_DB_USER=operational_context_user
OPERATIONAL_CONTEXT_DB_PASSWORD=change-this-operational-context-database-password
OPERATIONAL_CONTEXT_DB_PORT=5440

PARTY_IDENTITY_DB_NAME=party_identity
PARTY_IDENTITY_DB_USER=party_identity_user
PARTY_IDENTITY_DB_PASSWORD=change-this-party-identity-database-password
PARTY_IDENTITY_DB_PORT=5441

GEOGRAPHY_DB_NAME=geography
GEOGRAPHY_DB_USER=geography_user
GEOGRAPHY_DB_PASSWORD=change-this-geography-database-password
GEOGRAPHY_DB_PORT=5442

PAYMENT_REFERENCE_DB_NAME=payment_reference
PAYMENT_REFERENCE_DB_USER=payment_reference_user
PAYMENT_REFERENCE_DB_PASSWORD=change-this-payment-reference-database-password
PAYMENT_REFERENCE_DB_PORT=5443

PRODUCT_CATALOG_DB_NAME=product_catalog
PRODUCT_CATALOG_DB_USER=product_catalog_user
PRODUCT_CATALOG_DB_PASSWORD=change-this-product-catalog-database-password
PRODUCT_CATALOG_DB_PORT=5444

COMMERCIAL_RELATIONSHIP_DB_NAME=commercial_relationship
COMMERCIAL_RELATIONSHIP_DB_USER=commercial_relationship_user
COMMERCIAL_RELATIONSHIP_DB_PASSWORD=change-this-commercial-relationship-database-password
COMMERCIAL_RELATIONSHIP_DB_PORT=5445

PURCHASE_DB_NAME=purchase
PURCHASE_DB_USER=purchase_user
PURCHASE_DB_PASSWORD=change-this-purchase-database-password
PURCHASE_DB_PORT=5446

SALES_DB_NAME=sales
SALES_DB_USER=sales_user
SALES_DB_PASSWORD=change-this-sales-database-password
SALES_DB_PORT=5447

INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change-this-inventory-database-password
INVENTORY_DB_PORT=5448

AUDIT_DB_NAME=audit
AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=change-this-audit-database-password
AUDIT_DB_PORT=5449

WORKFLOW_DB_NAME=workflow
WORKFLOW_DB_USER=workflow_user
WORKFLOW_DB_PASSWORD=change-this-workflow-database-password
WORKFLOW_DB_PORT=5450

# PostgreSQL de pruebas por microservicio (perfil "test" de
# infrastructure/services/<microservicio>.yaml; datos en tmpfs). Deben coincidir
# con <MICROSERVICIO>_TEST_DATABASE_URL del .env de cada servicio, que usan las
# pruebas. Puertos: docs/port-map.md.

GEOGRAPHY_TEST_DB_NAME=sio_geography_test
GEOGRAPHY_TEST_DB_USER=sio_geography_test
GEOGRAPHY_TEST_DB_PASSWORD=sio_geography_test_dev_change_me
GEOGRAPHY_TEST_DB_PORT=55433

PAYMENT_REFERENCE_TEST_DB_NAME=sio_payment_reference_test
PAYMENT_REFERENCE_TEST_DB_USER=sio_payment_reference_test
PAYMENT_REFERENCE_TEST_DB_PASSWORD=sio_payment_reference_test_dev_change_me
PAYMENT_REFERENCE_TEST_DB_PORT=55441

PARTY_IDENTITY_TEST_DB_NAME=sio_party_identity_test
PARTY_IDENTITY_TEST_DB_USER=sio_party_identity_test
PARTY_IDENTITY_TEST_DB_PASSWORD=sio_party_identity_test_dev_change_me
PARTY_IDENTITY_TEST_DB_PORT=55436

PRODUCT_CATALOG_TEST_DB_NAME=sio_product_catalog_test
PRODUCT_CATALOG_TEST_DB_USER=sio_product_catalog_test
PRODUCT_CATALOG_TEST_DB_PASSWORD=sio_product_catalog_test_dev_change_me
PRODUCT_CATALOG_TEST_DB_PORT=55438

OPERATIONAL_CONTEXT_TEST_DB_NAME=sio_operational_context_test
OPERATIONAL_CONTEXT_TEST_DB_USER=sio_operational_context_test
OPERATIONAL_CONTEXT_TEST_DB_PASSWORD=sio_operational_context_test_dev_change_me
OPERATIONAL_CONTEXT_TEST_DB_PORT=55440

COMMERCIAL_RELATIONSHIP_TEST_DB_NAME=sio_commercial_relationship_test
COMMERCIAL_RELATIONSHIP_TEST_DB_USER=sio_commercial_relationship_test
COMMERCIAL_RELATIONSHIP_TEST_DB_PASSWORD=sio_commercial_relationship_test_dev_change_me
COMMERCIAL_RELATIONSHIP_TEST_DB_PORT=55443

AUDIT_TEST_DB_NAME=sio_audit_test
AUDIT_TEST_DB_USER=sio_audit_test
AUDIT_TEST_DB_PASSWORD=sio_audit_test_dev_change_me
AUDIT_TEST_DB_PORT=55451

INVENTORY_TEST_DB_NAME=sio_inventory_test
INVENTORY_TEST_DB_USER=sio_inventory_test
INVENTORY_TEST_DB_PASSWORD=sio_inventory_test_dev_change_me
INVENTORY_TEST_DB_PORT=55449

PURCHASE_TEST_DB_NAME=sio_purchase_test
PURCHASE_TEST_DB_USER=sio_purchase_test
PURCHASE_TEST_DB_PASSWORD=sio_purchase_test_dev_change_me
PURCHASE_TEST_DB_PORT=55445

# Base de pruebas de sales-service (docs/port-map.md: 55447). Si el host excluye ese puerto
# (rango reservado por Hyper-V/WinNAT), poner otro valor solo en infrastructure/.env.
SALES_TEST_DB_NAME=sio_sales_test
SALES_TEST_DB_USER=sio_sales_test
SALES_TEST_DB_PASSWORD=sio_sales_test_dev_change_me
SALES_TEST_DB_PORT=55447

# PostgreSQL Keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=change-this-keycloak-database-password
KEYCLOAK_DB_PORT=5433

# Administración inicial de Keycloak
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-this-keycloak-admin-password
# Usuarios de Keycloak
# El realm sio exige: 12+ caracteres, al menos 1 mayúscula, 1 minúscula y 1
# dígito (ver keycloak/realm-template/sio-realm.template.json,
# passwordPolicy). render-realm.sh valida esto antes de renderizar.
KEYCLOAK_TEST_USER_PASSWORD=ChangeThisPassw0rd

# Keycloak
KEYCLOAK_REALM=sio
KEYCLOAK_HTTP_PORT=8081
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Frontend
SIO_WEB_ORIGIN=http://localhost:3000
SIO_WEB_REDIRECT_URI=http://localhost:3000/*

# Aplicaciones (microservicios) — puerto host de cada uno en el entorno
# integrado (rango 8101-8111), ver docs/port-map.md
PARTY_IDENTITY_SERVICE_PORT=8101
GEOGRAPHY_SERVICE_PORT=8102
PRODUCT_CATALOG_SERVICE_PORT=8103
OPERATIONAL_CONTEXT_SERVICE_PORT=8104
# Reservados: el servicio aún no tiene contenedor en infrastructure/services/<servicio>.yaml.
PAYMENT_REFERENCE_SERVICE_PORT=8105
COMMERCIAL_RELATIONSHIP_SERVICE_PORT=8106
PURCHASE_SERVICE_PORT=8107
SALES_SERVICE_PORT=8108
INVENTORY_SERVICE_PORT=8109
AUDIT_SERVICE_PORT=8110
WORKFLOW_SERVICE_PORT=8111
PARTY_IDENTITY_SERVICE_BASE_URL=http://party-identity-service:8000/api/v1
OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://operational-context-service:8000/api/v1
OPERATIONAL_CONTEXT_TIMEOUT_SECONDS=5

# Secreto del cliente técnico party-identity-service (client_credentials).
# Se inyecta en la plantilla del realm y en el servicio; nunca un valor real aquí.
PARTY_IDENTITY_CLIENT_SECRET=change-this-party-identity-client-secret

# Secreto del cliente técnico operational-context-service (client_credentials,
# Admin API de solo lectura: view-users y query-clients). Se inyecta en la
# plantilla del realm y en el servicio; nunca un valor real aquí.
OPERATIONAL_CONTEXT_CLIENT_SECRET=change-this-operational-context-client-secret

# Secreto del cliente técnico commercial-relationship-service (client_credentials
# solo hacia Product Catalog: batch-lookup y first-use). Se inyecta en la
# plantilla del realm y en el servicio; nunca un valor real aquí.
COMMERCIAL_RELATIONSHIP_CLIENT_SECRET=change-this-commercial-relationship-client-secret

# Secreto del cliente técnico de pruebas audit-test-emitter (client_credentials,
# solo perm:audit:audit-events:create; feature 011, R-13). Lo usan las pruebas de
# integración de audit-service y de libs/sio-audit. Nunca un valor real aquí.
AUDIT_TEST_EMITTER_CLIENT_SECRET=change-this-audit-test-emitter-secret

# Secreto del cliente técnico inventory-service (client_credentials; feature 012, R-12):
# lectura técnica en Operational Context y Commercial Relationship (platform:lookup) y
# registro de auditoría (perm:audit:audit-events:create). Lo usan la API y el
# inventory-audit-outbox-worker. Nunca un valor real aquí.
INVENTORY_SERVICE_CLIENT_SECRET=change-this-inventory-service-secret

# Secreto del cliente técnico de pruebas inventory-test-operator (client_credentials,
# permisos perm:inventory:*; feature 012, DS-13). Lo usan las pruebas de integración
# de inventory-service. Nunca un valor real aquí.
INVENTORY_TEST_OPERATOR_CLIENT_SECRET=change-this-inventory-test-operator-secret

# Secreto del cliente técnico purchase-service (client_credentials; feature 014, R-02):
# lectura técnica en Operational Context, Commercial Relationship, Product Catalog,
# Party Identity y Payment Reference; entradas, reversos y conciliación en Inventory;
# registro de auditoría. Lo usan la API, el purchase-audit-outbox-worker y el
# purchase-reconciler. Nunca un valor real aquí.
PURCHASE_SERVICE_CLIENT_SECRET=change-this-purchase-service-secret

# Secreto del cliente técnico sales-service (client_credentials; feature 015, R-02):
# lectura técnica en Operational Context, Commercial Relationship (clientes, productos,
# presentaciones, listas y precio aplicable), Product Catalog y Party Identity; salidas,
# reversos, saldos y conciliación en Inventory; registro de auditoría. Lo usan la API, el
# sales-audit-outbox-worker y el sales-reconciler. Nunca un valor real aquí.
SALES_SERVICE_CLIENT_SECRET=change-this-sales-service-secret

# Secreto del cliente técnico product-catalog-service (client_credentials; feature 016, C-02):
# solo registro de auditoría (perm:audit:audit-events:create). Lo usa el
# product-catalog-audit-outbox-worker. Party Identity, Operational Context y Commercial
# Relationship entregan su auditoría con sus secretos existentes. Nunca un valor real aquí.
PRODUCT_CATALOG_SERVICE_CLIENT_SECRET=change-this-product-catalog-service-secret

# Documentación interactiva de los microservicios: Swagger UI (/docs) y el esquema
# (/openapi.json), públicos sin Bearer cuando está habilitada. Las rutas funcionales siguen
# exigiendo token y /health siempre es público.
# - Desarrollo: true.
# - Producción: false o no definida (no se publica la documentación).
# Si no se define, Compose usa false (`${SIO_DOCS_ENABLED:-false}` en services/*.yaml).
SIO_DOCS_ENABLED=true

# Almacenamiento de objetos de SIO (proyecto object-storage, MinIO, API S3): contenido de los
# activos de Product Catalog (imágenes de producto) en un bucket privado. Valores reales solo en
# infrastructure/.env; nunca en el repositorio ni en reportes.
# root: solo lo usa el bootstrap (bucket, políticas y cuentas); las aplicaciones no.
OBJECT_STORAGE_API_PORT=9002
OBJECT_STORAGE_CONSOLE_PORT=9003
OBJECT_STORAGE_BUCKET=sio-product-assets
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Cuenta de Product Catalog: solo lectura de assets/* (la usa GET .../assets/{id}/content).
PRODUCT_CATALOG_ASSET_STORAGE_ACCESS_KEY=
PRODUCT_CATALOG_ASSET_STORAGE_SECRET_KEY=
# Cuenta de la herramienta de migración (tools/data-migration): lectura y escritura de assets/*,
# sin borrado. El loader las recibe como SIO_MIGRATION_ASSET_STORAGE_ACCESS_KEY / _SECRET_KEY.
MIGRATION_ASSET_STORAGE_ACCESS_KEY=
MIGRATION_ASSET_STORAGE_SECRET_KEY=

# Secreto del cliente técnico sio-data-importer (client_credentials): cargue de datos de empresas con
# tools/data-migration/ia-tools/cargar_gold.py (--rol cliente:sio-data-importer). Solo consulta y creación
# del catálogo global, organizaciones y productos; sin borrar ni inactivar. Nunca un valor real aquí.
SIO_DATA_IMPORTER_CLIENT_SECRET=change-this-sio-data-importer-secret

# Spec 021: workers de precios automáticos por recepción (opcionales; Compose usa estos valores por
# defecto si no se definen). Sin secretos: la entrega usa el cliente técnico purchase-service.
# - commercial-relationship-price-worker: procesa las aplicaciones de precios (solo su base).
CR_PRICE_WORKER_INTERVAL_SECONDS=5
CR_PRICE_WORKER_BATCH_SIZE=50
CR_PRICE_WORKER_MAX_BACKOFF_SECONDS=300
# - purchase-price-update-worker: entrega las solicitudes a Commercial Relationship (EXC-001).
PURCHASE_PRICE_WORKER_INTERVAL_SECONDS=5
PURCHASE_PRICE_WORKER_MAX_BACKOFF_SECONDS=300
