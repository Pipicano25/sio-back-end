# Copia a neon-migration.env, configura cada URL y ejecuta chmod 600 neon-migration.env.
# Usa conexiones DIRECTAS (sin pooler) de Neon, preferiblemente bases vacías.
# No subas neon-migration.env ni archivos .dump a GitHub.
NEON_GEOGRAPHY_URL='postgresql://USUARIO:CONTRASENA@HOST/sio_geography_dev?sslmode=require'
# Para migrar otros servicios, descomenta y configura cada base creada en Neon:
# NEON_PARTY_IDENTITY_URL='postgresql://...'
# NEON_PRODUCT_CATALOG_URL='postgresql://...'
# NEON_OPERATIONAL_CONTEXT_URL='postgresql://...'
# NEON_PAYMENT_REFERENCE_URL='postgresql://...'
# NEON_COMMERCIAL_RELATIONSHIP_URL='postgresql://...'
# NEON_PURCHASE_URL='postgresql://...'
# NEON_SALES_URL='postgresql://...'
# NEON_INVENTORY_URL='postgresql://...'
# NEON_AUDIT_URL='postgresql://...'
# NEON_WORKFLOW_URL='postgresql://...'
