# Despliegue unificado de SIO: plantilla de variables (sin valores reales).
#
# Reglas:
# - Las variables SIN prefijo son compartidas por los 12 servicios.
# - Las variables CON prefijo (`PURCHASE__DATABASE_URL`) solo las ve ese servicio, sin el
#   prefijo, y prevalecen sobre las compartidas.
# - Copie los valores de cada Web Service actual de Render a su prefijo; no invente secretos.
# - Las URL entre servicios (`*_SERVICE_BASE_URL`) NO se definen: apuntan solas a este mismo
#   proceso (http://127.0.0.1:$PORT/<servicio>). Defínalas con prefijo solo para excepciones.

# --- Proceso ---------------------------------------------------------------
# Render lo inyecta; en local vale 8000.
PORT=8000
# URL pública del Web Service unificado (para las URL de imágenes de Product Catalog).
SIO_UNIFIED_PUBLIC_URL=https://<servicio-unificado>.onrender.com
# Hilos para las rutas síncronas (las llamadas internas también los ocupan). Por defecto 100.
SIO_UNIFIED_THREAD_LIMIT=100

# --- Proceso: workers y supervisor -----------------------------------------
# all (los 11), none (solo la API) o nombres separados por comas (ver README).
# Use none si otro despliegue ya ejecuta los workers contra las mismas bases.
SIO_UNIFIED_WORKERS=all
# Render espera 30 s tras SIGTERM; el supervisor reparte este tiempo entre workers y API.
SIO_UNIFIED_SHUTDOWN_TIMEOUT=25
# Segundos de espera a la API antes de arrancar los workers (con 0,1 CPU tarda ≈ 75 s).
SIO_UNIFIED_API_START_TIMEOUT=300
SIO_UNIFIED_API_GRACEFUL_SECONDS=10
SIO_UNIFIED_WORKERS_STOP_TIMEOUT=12
# Entregas simultáneas a Audit entre los 7 workers de auditoría (0 = sin límite) y prioridad (nice)
# del proceso de workers. Con 0,1 CPU, 7 lotes a la vez saturan la API y ninguno termina a tiempo.
SIO_UNIFIED_AUDIT_CONCURRENCY=1
SIO_UNIFIED_WORKERS_NICE=10
# Workers de auditoría en Render Free: lotes de 20 y 30 s de espera (en Compose: 100 y 5 s). Con 0,1
# CPU, Audit tarda más de 5 s en un lote de 100 y el worker reintenta sin fin (no se pierde nada).
# Carpeta de latidos, estado y bloqueos (por defecto /tmp/sio-unified).
# SIO_UNIFIED_STATE_DIR=/tmp/sio-unified

# --- Compartidas: autenticación y documentación ----------------------------
SIO_DOCS_ENABLED=false
SIO_AUTH_ISSUER=https://<keycloak>/realms/siodev
SIO_AUTH_AUDIENCE=sio-api
SIO_AUTH_JWKS_URL=https://<keycloak>/realms/siodev/protocol/openid-connect/certs

# --- Compartidas: Keycloak (cuentas técnicas) ------------------------------
KEYCLOAK_BASE_URL=https://<keycloak>
KEYCLOAK_REALM=siodev
KEYCLOAK_TOKEN_URL=https://<keycloak>/realms/siodev/protocol/openid-connect/token
KEYCLOAK_TIMEOUT_SECONDS=5

# --- geography --------------------------------------------------------------
GEOGRAPHY__DATABASE_URL=postgresql+psycopg://<usuario>:<contraseña>@<host-neon>/<base>?sslmode=require

# --- party-identity --------------------------------------------------------
PARTY_IDENTITY__DATABASE_URL=postgresql+psycopg://<usuario>:<contraseña>@<host-neon>/<base>?sslmode=require
PARTY_IDENTITY__PARTY_IDENTITY_CLIENT_ID=party-identity-service
PARTY_IDENTITY__PARTY_IDENTITY_CLIENT_SECRET=<secreto>
PARTY_IDENTITY__GEOGRAPHY_TIMEOUT_SECONDS=5
PARTY_IDENTITY__OPERATIONAL_CONTEXT_TIMEOUT_SECONDS=5
PARTY_IDENTITY__PARTY_IDENTITY_SEED_COUNTRY_ID=
# audit-outbox-worker de este servicio (misma cuenta técnica que su Web Service actual).
PARTY_IDENTITY__AUDIT_CLIENT_ID=party-identity-service
PARTY_IDENTITY__AUDIT_CLIENT_SECRET=<secreto>
PARTY_IDENTITY__AUDIT_OUTBOX_POLL_INTERVAL_SECONDS=2
PARTY_IDENTITY__AUDIT_OUTBOX_HTTP_TIMEOUT_SECONDS=30
PARTY_IDENTITY__AUDIT_OUTBOX_BACKOFF_INITIAL_SECONDS=1
PARTY_IDENTITY__AUDIT_OUTBOX_BACKOFF_FACTOR=2
PARTY_IDENTITY__AUDIT_OUTBOX_BACKOFF_MAX_SECONDS=300
PARTY_IDENTITY__AUDIT_OUTBOX_BATCH_SIZE=20

# --- product-catalog -------------------------------------------------------
PRODUCT_CATALOG__DATABASE_URL=postgresql+psycopg://<usuario>:<contraseña>@<host-neon>/<base>?sslmode=require
PRODUCT_CATALOG__PARTY_IDENTITY_TIMEOUT_SECONDS=3
# La ruta pública de imágenes solo se registra con el secreto y una URL pública base, igual que
# en solitario; la URL base sale de SIO_UNIFIED_PUBLIC_URL (+ /product-catalog).
# PRODUCT_CATALOG__PRODUCT_IMAGE_REF_SECRET=<secreto>
# PRODUCT_CATALOG__PRODUCT_IMAGE_REF_SECRET_PREVIOUS=<secreto-anterior>
# audit-outbox-worker de este servicio (misma cuenta técnica que su Web Service actual).
PRODUCT_CATALOG__AUDIT_CLIENT_ID=product-catalog-service
PRODUCT_CATALOG__AUDIT_CLIENT_SECRET=<secreto>
PRODUCT_CATALOG__AUDIT_OUTBOX_POLL_INTERVAL_SECONDS=2
PRODUCT_CATALOG__AUDIT_OUTBOX_HTTP_TIMEOUT_SECONDS=30
PRODUCT_CATALOG__AUDIT_OUTBOX_BACKOFF_INITIAL_SECONDS=1
PRODUCT_CATALOG__AUDIT_OUTBOX_BACKOFF_FACTOR=2
PRODUCT_CATALOG__AUDIT_OUTBOX_BACKOFF_MAX_SECONDS=300
PRODUCT_CATALOG__AUDIT_OUTBOX_BATCH_SIZE=20

