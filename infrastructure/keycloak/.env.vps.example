# ============================================================
# KEYCLOAK — despliegue en la VPS
# ============================================================
# Plantilla de infrastructure/keycloak/.env.vps (no versionado: .gitignore y .dockerignore).
# Copie este archivo a .env.vps en esta misma carpeta y reemplace cada CHANGE_ME.
# Lo usa infrastructure/keycloak/docker-compose.vps.yml como env_file y para interpolar la versión y
# los puertos (--env-file).
# Escriba valores literales. Compose interpreta $ en este archivo: si un valor (p. ej. una
# contraseña) contiene $, enciérrelo entre comillas simples: CLAVE='valor$con$dolar'.
#
# No hay variables de importación (KEYCLOAK_TEST_USER_PASSWORD, secretos de clientes, SIO_WEB_*):
# solo las usa la plantilla del realm en desarrollo. En la VPS el realm ya está en la base.


# ============================================================
# DOCKER COMPOSE (interpolación)
# ============================================================
# Versión de Keycloak del proyecto (infrastructure/.env.example) y puertos del host
# (docs/port-map.md), publicados solo en 127.0.0.1.

KEYCLOAK_VERSION=26.7.0
KEYCLOAK_HTTP_PORT=8081
KEYCLOAK_MANAGEMENT_PORT=9000


# ============================================================
# POSTGRESQL (contenedor existente sio-postgres-18 en sio-network)
# ============================================================
# Base keycloak ya migrada a PostgreSQL 18. Keycloak no crea la base; al arrancar solo comprueba
# su esquema, que ya corresponde a esta misma versión.

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://sio-postgres-18:5432/keycloak
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=CHANGE_ME


# ============================================================
# HOSTNAME PÚBLICO Y PROXY INVERSO (HTTPS)
# ============================================================
# KC_HOSTNAME: URL pública completa (https://, sin barra final). Es el claim iss de todos los tokens:
# SIO_AUTH_ISSUER de cada microservicio debe ser exactamente KC_HOSTNAME + /realms/sio.
# Traefik (labels de docker-compose.vps.yml) termina TLS en :443 y reenvía al contenedor por HTTP
# en el puerto 8080 de sio-network (KC_HTTP_ENABLED) con X-Forwarded-For, X-Forwarded-Proto,
# X-Forwarded-Host y X-Forwarded-Port.
# Nunca publicar /health ni /metrics (puerto 9000, solo 127.0.0.1).

KC_HOSTNAME=https://auth.2.25.76.203.sslip.io
KC_HOSTNAME_STRICT=true
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
# Opcional: aceptar los encabezados solo desde el proxy (IP o CIDR, separados por comas).
# KC_PROXY_TRUSTED_ADDRESSES=CHANGE_ME
# Opcional: consola de administración en otra URL (p. ej. un host solo accesible por VPN).
# KC_HOSTNAME_ADMIN=https://CHANGE_ME_KEYCLOAK_ADMIN_HOST


# ============================================================
# OBSERVABILIDAD (puerto de administración 9000, solo 127.0.0.1)
# ============================================================
# Iguales a las del build de la imagen (Containerfile): si cambian, `start --optimized` falla.

KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_LOG_LEVEL=info


# ============================================================
# ADMINISTRADOR INICIAL
# ============================================================
# Solo se usa si el realm master NO tiene ningún usuario: crea un administrador TEMPORAL. Con la base
# migrada, el administrador existente se conserva y estas variables se ignoran. Cambie la contraseña
# por una real y, tras confirmar el acceso, puede vaciar ambas.

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
