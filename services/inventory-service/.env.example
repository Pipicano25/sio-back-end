# ============================================================
# INVENTORY SERVICE
# ============================================================
# Un único comportamiento funcional en todos los entornos: no existen
# variables de "modo" (stub, fake, test) para las dependencias; las pruebas
# inyectan dobles por DI (research.md R-14, R-16).

SIO_DOCS_ENABLED=true

# Operational Context: sucursal y usuario operativo (identidad técnica de
# Inventory con platform:lookup) y membresía del usuario consultante
# (operational-access con su propio token). La URL base INCLUYE /api/v1.
OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://localhost:8104/api/v1
OPERATIONAL_CONTEXT_TIMEOUT_SECONDS=5

# Commercial Relationship: productos empresariales por lotes (identidad técnica
# con platform:lookup). La URL base INCLUYE /api/v1.
COMMERCIAL_RELATIONSHIP_SERVICE_BASE_URL=http://localhost:8106/api/v1
COMMERCIAL_RELATIONSHIP_TIMEOUT_SECONDS=5

# Tiempo máximo de espera de los bloqueos de saldo (R-04); agotado → 503.
INVENTORY_LOCK_TIMEOUT_SECONDS=5


# ============================================================
# IDENTIDAD TÉCNICA DE INVENTORY (client_credentials, D5)
# ============================================================
# Cliente "inventory-service" del realm. El secreto real NUNCA se versiona:
# copiarlo de infrastructure/.env (INVENTORY_SERVICE_CLIENT_SECRET).

KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/sio/protocol/openid-connect/token
INVENTORY_CLIENT_ID=inventory-service
INVENTORY_CLIENT_SECRET=change-this-inventory-service-secret


# ============================================================
# POSTGRESQL
# ============================================================
# Base y base de pruebas del proyecto compose "inventory-service"
# (infrastructure/services/inventory-service.yaml); credenciales y puertos en
# infrastructure/.env (docs/port-map.md). Base de pruebas:
#   docker compose --file ../../infrastructure/services/inventory-service.yaml --env-file ../../infrastructure/.env --profile test up -d inventory-test-db

DATABASE_URL=postgresql+psycopg://inventory_user:change-this-inventory-database-password@127.0.0.1:5448/inventory
INVENTORY_TEST_DATABASE_URL=postgresql+psycopg://sio_inventory_test:sio_inventory_test_dev_change_me@127.0.0.1:55449/sio_inventory_test


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api


# ============================================================
# AUDIT-OUTBOX-WORKER (python -m sio_audit.worker; libs/sio-audit/README.md)
# ============================================================
# Usa la misma base (DATABASE_URL) y el mismo cliente técnico de Inventory.

AUDIT_SERVICE_BASE_URL=http://localhost:8110/api/v1
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=sio
AUDIT_CLIENT_ID=inventory-service
AUDIT_CLIENT_SECRET=change-this-inventory-service-secret
AUDIT_OUTBOX_POLL_INTERVAL_SECONDS=2
AUDIT_OUTBOX_HTTP_TIMEOUT_SECONDS=5
AUDIT_OUTBOX_BACKOFF_INITIAL_SECONDS=1
AUDIT_OUTBOX_BACKOFF_FACTOR=2
AUDIT_OUTBOX_BACKOFF_MAX_SECONDS=300
AUDIT_OUTBOX_BATCH_SIZE=100


# ============================================================
# PRUEBAS DE INTEGRACIÓN (pytest -m integration)
# ============================================================
# Solo las usa tests/integration contra el entorno integrado. Los secretos
# reales (INVENTORY_TEST_OPERATOR_CLIENT_SECRET, KEYCLOAK_TEST_USER_PASSWORD)
# se leen del entorno o de infrastructure/.env; nunca se versionan.

INVENTORY_INTEGRATION_BASE_URL=http://localhost:8109/api/v1
OPERATIONAL_CONTEXT_INTEGRATION_BASE_URL=http://localhost:8104/api/v1
COMMERCIAL_RELATIONSHIP_INTEGRATION_BASE_URL=http://localhost:8106/api/v1
AUDIT_INTEGRATION_BASE_URL=http://localhost:8110/api/v1
INVENTORY_TEST_OPERATOR_CLIENT_ID=inventory-test-operator
