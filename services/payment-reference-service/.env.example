# ============================================================
# PAYMENT REFERENCE SERVICE
# ============================================================

SIO_DOCS_ENABLED=true


# ============================================================
# POSTGRESQL
# ============================================================
# Base y base de pruebas del proyecto compose "payment-reference-service"
# (infrastructure/services/payment-reference-service.yaml); sus credenciales y puertos se
# definen en infrastructure/.env (docs/port-map.md). Base de pruebas:
#   docker compose --file ../../infrastructure/services/payment-reference-service.yaml --env-file ../../infrastructure/.env --profile test up -d payment-reference-test-db

# Base aislada de pruebas (perfil "test"). Valores ficticios:
# si Windows reserva el puerto, cámbielo solo en su .env local.
PAYMENT_REFERENCE_TEST_DATABASE_URL=postgresql+psycopg://sio_payment_reference_test:sio_payment_reference_test_dev_change_me@127.0.0.1:55441/sio_payment_reference_test


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api
