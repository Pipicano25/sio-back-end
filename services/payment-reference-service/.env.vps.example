# ============================================================
# PAYMENT REFERENCE SERVICE — despliegue en la VPS
# ============================================================
# Plantilla de services/payment-reference-service/.env.vps (no versionado: .gitignore y .dockerignore).
# Copie este archivo a .env.vps en esta misma carpeta y reemplace cada CHANGE_ME.
# Lo usa services/payment-reference-service/docker-compose.vps.yml como env_file de la API.
# Escriba valores literales. Compose interpreta $ en este archivo: si un valor (p. ej. una
# contraseña) contiene $, enciérrelo entre comillas simples: CLAVE='valor$con$dolar'.
# Ninguna imagen ejecuta migraciones ni seeds al arrancar.


# ============================================================
# DOCKER COMPOSE (interpolación: --env-file services/payment-reference-service/.env.vps)
# ============================================================
# Tag de la imagen local y puerto del host (docs/port-map.md; no cambiarlo).

SIO_SERVICES_VERSION=0.1.0
PAYMENT_REFERENCE_SERVICE_PORT=8105


# ============================================================
# POSTGRESQL (contenedor existente sio-postgres-18 en sio-network)
# ============================================================
# Puerto interno 5432; base y usuario propios del microservicio. Si la contraseña tiene
# caracteres reservados de URL (@ : / ? # % &), escríbala codificada (p. ej. @ -> %40).

DATABASE_URL=postgresql+psycopg://payment_reference_user:CHANGE_ME@sio-postgres-18:5432/payment_reference


# ============================================================
# SIO AUTH (Keycloak)
# ============================================================
# El issuer es la URL PÚBLICA de Keycloak: debe coincidir exactamente con el claim iss de los
# tokens. Las llaves (JWKS) también se obtienen por la URL pública de Keycloak.

SIO_AUTH_ISSUER=https://auth.2.25.76.203.sslip.io/realms/sio
SIO_AUTH_JWKS_URL=https://auth.2.25.76.203.sslip.io/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api
# Swagger UI (/docs) y /openapi.json públicos, sin token (sio-auth los excluye de forma exacta).
SIO_DOCS_ENABLED=true
