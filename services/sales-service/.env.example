# ============================================================
# SALES SERVICE
# ============================================================
# Un único comportamiento funcional en todos los entornos: no existen
# variables de "modo" (stub, fake, test) para las dependencias; las pruebas
# inyectan dobles por DI (research.md R-15, R-17).

SIO_DOCS_ENABLED=true

# Dependencias (specs/015-sales-core/contracts/dependencies.md). Todas las URL
# INCLUYEN /api/v1. Sin Payment Reference: el MVP solo vende de contado (DP-01).
OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://localhost:8104/api/v1
OPERATIONAL_CONTEXT_TIMEOUT_SECONDS=5
COMMERCIAL_RELATIONSHIP_SERVICE_BASE_URL=http://localhost:8106/api/v1
COMMERCIAL_RELATIONSHIP_TIMEOUT_SECONDS=5
PRODUCT_CATALOG_SERVICE_BASE_URL=http://localhost:8103/api/v1
PRODUCT_CATALOG_TIMEOUT_SECONDS=5
PARTY_IDENTITY_SERVICE_BASE_URL=http://localhost:8101/api/v1
PARTY_IDENTITY_TIMEOUT_SECONDS=5
# Spec 020: medio de pago declarado; sin /api/v1 (brecha del proveedor)
PAYMENT_REFERENCE_SERVICE_BASE_URL=http://localhost:8105
PAYMENT_REFERENCE_TIMEOUT_SECONDS=5
INVENTORY_SERVICE_BASE_URL=http://localhost:8109/api/v1
INVENTORY_TIMEOUT_SECONDS=10

# Consultas en paralelo por solicitud y espera máxima de bloqueos (R-06, R-05).
SALES_LOOKUP_CONCURRENCY=8
SALES_LOCK_TIMEOUT_SECONDS=5

# Conciliador de operaciones PENDING (python -m sales_service.reconciler; R-16).
# El umbral debe ser al menos 10 veces INVENTORY_TIMEOUT_SECONDS.
SALES_RECONCILER_INTERVAL_SECONDS=60
SALES_RECONCILER_THRESHOLD_SECONDS=300


# ============================================================
# IDENTIDAD TÉCNICA DE SALES (client_credentials, D5)
# ============================================================
# Cliente "sales-service" del realm. El secreto real NUNCA se versiona:
# copiarlo de infrastructure/.env (SALES_SERVICE_CLIENT_SECRET).

KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/sio/protocol/openid-connect/token
SALES_CLIENT_ID=sales-service
SALES_CLIENT_SECRET=change-this-sales-service-secret


# ============================================================
# POSTGRESQL
# ============================================================
# Base y base de pruebas del proyecto compose "sales-service"
# (infrastructure/services/sales-service.yaml); credenciales y puertos en
# infrastructure/.env (docs/port-map.md). Base de pruebas:
#   docker compose --file ../../infrastructure/services/sales-service.yaml --env-file ../../infrastructure/.env --profile test up -d sales-test-db

DATABASE_URL=postgresql+psycopg://sales_user:change-this-sales-database-password@127.0.0.1:5447/sales
SALES_TEST_DATABASE_URL=postgresql+psycopg://sio_sales_test:sio_sales_test_dev_change_me@127.0.0.1:55447/sio_sales_test


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api


# ============================================================
# AUDIT-OUTBOX-WORKER (python -m sio_audit.worker; libs/sio-audit/README.md)
# ============================================================
# Usa la misma base (DATABASE_URL) y el mismo cliente técnico de Sales.

AUDIT_SERVICE_BASE_URL=http://localhost:8110/api/v1
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=sio
AUDIT_CLIENT_ID=sales-service
AUDIT_CLIENT_SECRET=change-this-sales-service-secret
AUDIT_OUTBOX_POLL_INTERVAL_SECONDS=2
AUDIT_OUTBOX_HTTP_TIMEOUT_SECONDS=5
AUDIT_OUTBOX_BACKOFF_INITIAL_SECONDS=1
AUDIT_OUTBOX_BACKOFF_FACTOR=2
AUDIT_OUTBOX_BACKOFF_MAX_SECONDS=300
AUDIT_OUTBOX_BATCH_SIZE=100


# ============================================================
# PRUEBAS DE INTEGRACIÓN (pytest -m integration)
# ============================================================
# Solo las usa tests/integration contra el entorno integrado. Los secretos
# reales (KEYCLOAK_TEST_USER_PASSWORD, INVENTORY_TEST_OPERATOR_CLIENT_SECRET)
# se leen del entorno o de infrastructure/.env; nunca se versionan.

SALES_INTEGRATION_BASE_URL=http://localhost:8108/api/v1
