# product-inventory-query-service: variables de entorno (spec 022, research.md R-17).
# Copiar a .env para desarrollo local. Los valores de ejemplo NO son secretos reales.

# --- sio-auth (Keycloak) ---
SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api
# /docs y /openapi.json solo públicos cuando está habilitado (Principio V).
SIO_DOCS_ENABLED=true

# --- Dependencias (las URL incluyen /api/v1; Principio XV) ---
OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://localhost:8104/api/v1
COMMERCIAL_RELATIONSHIP_SERVICE_BASE_URL=http://localhost:8106/api/v1
PRODUCT_CATALOG_SERVICE_BASE_URL=http://localhost:8103/api/v1
INVENTORY_SERVICE_BASE_URL=http://localhost:8109/api/v1

# --- Tiempos (RNF-022-3, FR-022-136) ---
# Tiempo de espera de cada llamada a una dependencia.
PIQS_DEPENDENCY_TIMEOUT_SECONDS=3
# Presupuesto total de la solicitud; debe ser >= PIQS_WORK_TIME_SECONDS + PIQS_DEPENDENCY_TIMEOUT_SECONDS.
PIQS_REQUEST_BUDGET_SECONDS=8
# Tiempo de trabajo de la búsqueda progresiva (se comprueba entre lotes).
PIQS_WORK_TIME_SECONDS=5
PIQS_MAX_BATCHES_PER_REQUEST=5

# --- Lotes internos: min(max(page_size * FACTOR, MIN), MAX) (FR-022-133) ---
PIQS_BATCH_MIN=20
PIQS_BATCH_FACTOR=2
PIQS_BATCH_MAX=40
PIQS_MAX_PARALLEL_CALLS=8

# --- Cursor firmado (FR-022-145 a FR-022-147) ---
# Al menos 32 bytes. En rotación, el saliente va en PIQS_CURSOR_SECRET_PREVIOUS.
PIQS_CURSOR_SECRET=change-this-cursor-secret-at-least-32-bytes
PIQS_CURSOR_SECRET_PREVIOUS=
PIQS_CURSOR_TTL_SECONDS=900

# Caché en memoria de unidades de medida (FR-022-02).
PIQS_REFERENCE_CACHE_SECONDS=300

# --- Identidad técnica propia (client_credentials, D5) ---
KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/sio/protocol/openid-connect/token
PIQS_CLIENT_ID=product-inventory-query-service
PIQS_CLIENT_SECRET=change-this-product-inventory-query-service-secret
