# ============================================================
# PRODUCT INVENTORY QUERY SERVICE — despliegue en la VPS
# ============================================================
# Plantilla de services/product-inventory-query-service/.env.vps (no versionado: .gitignore y .dockerignore).
# Copie este archivo a .env.vps en esta misma carpeta y reemplace cada CHANGE_ME.
# Lo usa services/product-inventory-query-service/docker-compose.vps.yml como env_file de la API.
# Escriba valores literales. Compose interpreta $ en este archivo: si un valor (p. ej. una
# contraseña) contiene $, enciérrelo entre comillas simples: CLAVE='valor$con$dolar'.
# Ninguna imagen ejecuta migraciones ni seeds al arrancar.


# ============================================================
# DOCKER COMPOSE (interpolación: --env-file services/product-inventory-query-service/.env.vps)
# ============================================================
# Tag de la imagen local y puerto del host (docs/port-map.md; no cambiarlo).

SIO_SERVICES_VERSION=0.1.0
PRODUCT_INVENTORY_QUERY_SERVICE_PORT=8112


# ============================================================
# SIO AUTH (Keycloak)
# ============================================================
# El issuer es la URL PÚBLICA de Keycloak: debe coincidir exactamente con el claim iss de los
# tokens. Las llaves (JWKS) también se obtienen por la URL pública de Keycloak.

SIO_AUTH_ISSUER=https://auth.2.25.76.203.sslip.io/realms/sio
SIO_AUTH_JWKS_URL=https://auth.2.25.76.203.sslip.io/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api
# Producción: sin Swagger UI ni /openapi.json públicos.
SIO_DOCS_ENABLED=false


# ============================================================
# DEPENDENCIAS
# ============================================================
# Todas con /api/v1. Sin dependencia de arranque: si faltan, cada consulta responde 503.

OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://operational-context-service:8000/api/v1
COMMERCIAL_RELATIONSHIP_SERVICE_BASE_URL=http://commercial-relationship-service:8000/api/v1
PRODUCT_CATALOG_SERVICE_BASE_URL=http://product-catalog-service:8000/api/v1
INVENTORY_SERVICE_BASE_URL=http://inventory-service:8000/api/v1


# ============================================================
# TIEMPOS Y LOTES
# ============================================================
# Valores del entorno integrado (RNF-022-3, FR-022-136).

PIQS_DEPENDENCY_TIMEOUT_SECONDS=3
PIQS_REQUEST_BUDGET_SECONDS=8
PIQS_WORK_TIME_SECONDS=5
PIQS_MAX_BATCHES_PER_REQUEST=5
PIQS_BATCH_MIN=20
PIQS_BATCH_FACTOR=2
PIQS_BATCH_MAX=40
PIQS_MAX_PARALLEL_CALLS=8
PIQS_REFERENCE_CACHE_SECONDS=300


# ============================================================
# CURSOR FIRMADO
# ============================================================
# Secreto HMAC de al menos 32 bytes: con CHANGE_ME el servicio NO arranca (validación de
# config.py). En una rotación, el saliente va en PIQS_CURSOR_SECRET_PREVIOUS durante 15 minutos.

PIQS_CURSOR_SECRET=CHANGE_ME
PIQS_CURSOR_SECRET_PREVIOUS=
PIQS_CURSOR_TTL_SECONDS=900


# ============================================================
# IDENTIDAD TÉCNICA (client_credentials, solo lectura)
# ============================================================
# Cliente "product-inventory-query-service" del realm.

KEYCLOAK_TOKEN_URL=https://auth.2.25.76.203.sslip.io/realms/sio/protocol/openid-connect/token
PIQS_CLIENT_ID=product-inventory-query-service
PIQS_CLIENT_SECRET=CHANGE_ME
