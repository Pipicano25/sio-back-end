# ============================================================
# COMMERCIAL RELATIONSHIP SERVICE
# ============================================================
# Un único comportamiento funcional en todos los entornos: no existen
# variables de "modo" (stub, fake, test) para las dependencias (R-16).

SIO_DOCS_ENABLED=true

# Operational Context: acceso operativo (vía propia) y empresa por UUID.
# La URL base INCLUYE el prefijo /api/v1.
OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://localhost:8104/api/v1
OPERATIONAL_CONTEXT_TIMEOUT_SECONDS=5
# Spec 025 (D27): lecturas de Operational Context. `http` (por omisión) o `contract`: con `contract` se leen las
# vistas contract.v1_operational_access, v1_companies y v1_user_memberships con el rol de solo lectura
# (infrastructure/scripts/contract-readers).
OPERATIONAL_CONTEXT_READ_SOURCE=http
# OPERATIONAL_CONTEXT_CONTRACT_DATABASE_URL=postgresql+psycopg://cr_contract_reader:change-this-contract-reader-password@localhost:5440/operational_context

# Product Catalog: batch-lookup y first-use con la identidad técnica propia.
PRODUCT_CATALOG_SERVICE_BASE_URL=http://localhost:8103/api/v1
PRODUCT_CATALOG_TIMEOUT_SECONDS=5
# Spec 025 (D27): lecturas de Product Catalog. `http` (por omisión) o `contract`: con `contract` la unidad base se lee
# de contract.v1_products (rol cr_contract_reader). batch-lookup (elegibilidad) y first-use siguen por API (FR-036).
PRODUCT_CATALOG_READ_SOURCE=http
# PRODUCT_CATALOG_CONTRACT_DATABASE_URL=postgresql+psycopg://cr_contract_reader:change-this-contract-reader-password@localhost:5444/product_catalog

# Party Identity: personas, organizaciones y personas de contacto (token del usuario).
PARTY_IDENTITY_SERVICE_BASE_URL=http://localhost:8101/api/v1
PARTY_IDENTITY_TIMEOUT_SECONDS=5
# Spec 025 (D27): lecturas de Party Identity. `http` (por omisión) o `contract`: con `contract` se leen las vistas
# v1_person_identities, v1_organization_identities y v1_organization_contact_persons (rol cr_contract_reader).
PARTY_IDENTITY_READ_SOURCE=http
# PARTY_IDENTITY_CONTRACT_DATABASE_URL=postgresql+psycopg://cr_contract_reader:change-this-contract-reader-password@localhost:5441/party_identity

# Payment Reference: tipo de condición de pago por UUID con la identidad técnica
# propia (feature 010). La URL base NO incluye /api/v1: el proveedor aún no
# publica el prefijo (GAP-PR-14, C-06); al corregirse solo cambia este valor.
PAYMENT_REFERENCE_SERVICE_BASE_URL=http://localhost:8105
PAYMENT_REFERENCE_TIMEOUT_SECONDS=5
# Spec 025 (D27): lecturas de Payment Reference. `http` (por omisión) o `contract`: con `contract` el tipo de condición
# de pago se lee de contract.v1_payment_condition_types (rol cr_contract_reader).
PAYMENT_REFERENCE_READ_SOURCE=http
# PAYMENT_REFERENCE_CONTRACT_DATABASE_URL=postgresql+psycopg://cr_contract_reader:change-this-contract-reader-password@localhost:5443/payment_reference

# Identidad técnica propia (client_credentials) hacia Product Catalog y Payment Reference.
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=sio
COMMERCIAL_RELATIONSHIP_CLIENT_ID=commercial-relationship-service
# Solo en .env, nunca versionado. Debe coincidir con el secreto del realm.
COMMERCIAL_RELATIONSHIP_CLIENT_SECRET=change-this-commercial-relationship-client-secret
KEYCLOAK_TIMEOUT_SECONDS=5


# ============================================================
# POSTGRESQL
# ============================================================
# Base y base de pruebas del proyecto compose "commercial-relationship-service"
# (infrastructure/services/commercial-relationship-service.yaml); sus credenciales y puertos se
# definen en infrastructure/.env (docs/port-map.md). Base de pruebas:
#   docker compose --file ../../infrastructure/services/commercial-relationship-service.yaml --env-file ../../infrastructure/.env --profile test up -d commercial-relationship-test-db

COMMERCIAL_RELATIONSHIP_TEST_DATABASE_URL=postgresql+psycopg://sio_commercial_relationship_test:sio_commercial_relationship_test_dev_change_me@127.0.0.1:55443/sio_commercial_relationship_test

DATABASE_URL=postgresql+psycopg://commercial_relationship_user:change-this-commercial-relationship-database-password@127.0.0.1:5445/commercial_relationship
# Pool del motor propio (spec 025, R6): conexiones abiertas a la base del servicio por proceso.
# DB_POOL_SIZE (por defecto 3, 1–20) y DB_MAX_OVERFLOW (por defecto 2, 0–20).
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api


# ============================================================
# PRUEBAS DE INTEGRACIÓN (pytest -m integration)
# ============================================================
# Solo las usa tests/integration contra servicios reales. La contraseña real
# nunca se versiona: se lee de KEYCLOAK_TEST_USER_PASSWORD o de infrastructure/.env.

# Apuntan al entorno integrado (infrastructure/scripts/rebuild-all.sh): la prueba
# crea los datos en los mismos proveedores que usa el contenedor de este servicio.
# El secreto del cliente técnico se lee de COMMERCIAL_RELATIONSHIP_INTEGRATION_CLIENT_SECRET
# o de infrastructure/.env (conftest.py fija COMMERCIAL_RELATIONSHIP_CLIENT_SECRET de prueba).
COMMERCIAL_RELATIONSHIP_INTEGRATION_BASE_URL=http://localhost:8106
OPERATIONAL_CONTEXT_INTEGRATION_BASE_URL=http://localhost:8104/api/v1
PRODUCT_CATALOG_INTEGRATION_BASE_URL=http://localhost:8103/api/v1
PARTY_IDENTITY_INTEGRATION_BASE_URL=http://localhost:8101/api/v1
GEOGRAPHY_INTEGRATION_BASE_URL=http://localhost:8102
KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/sio/protocol/openid-connect/token
