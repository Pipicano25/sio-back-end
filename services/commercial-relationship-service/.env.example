# ============================================================
# COMMERCIAL RELATIONSHIP SERVICE
# ============================================================
# Un único comportamiento funcional en todos los entornos: no existen
# variables de "modo" (stub, fake, test) para las dependencias (R-16).

SIO_DOCS_ENABLED=true
COMMERCIAL_RELATIONSHIP_SERVICE_PORT=8005

# Operational Context: acceso operativo (vía propia) y empresa por UUID.
# La URL base INCLUYE el prefijo /api/v1.
OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://localhost:8004/api/v1
OPERATIONAL_CONTEXT_TIMEOUT_SECONDS=5

# Product Catalog: batch-lookup y first-use con la identidad técnica propia.
PRODUCT_CATALOG_SERVICE_BASE_URL=http://localhost:8003/api/v1
PRODUCT_CATALOG_TIMEOUT_SECONDS=5

# Party Identity: personas, organizaciones y personas de contacto (token del usuario).
PARTY_IDENTITY_SERVICE_BASE_URL=http://localhost:8002/api/v1
PARTY_IDENTITY_TIMEOUT_SECONDS=5

# Identidad técnica propia (client_credentials) solo hacia Product Catalog.
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=sio
COMMERCIAL_RELATIONSHIP_CLIENT_ID=commercial-relationship-service
# Solo en .env, nunca versionado. Debe coincidir con el secreto del realm.
COMMERCIAL_RELATIONSHIP_CLIENT_SECRET=change-this-commercial-relationship-client-secret
KEYCLOAK_TIMEOUT_SECONDS=5


# ============================================================
# POSTGRESQL
# ============================================================

COMMERCIAL_RELATIONSHIP_DB_NAME=sio_commercial_relationship
COMMERCIAL_RELATIONSHIP_DB_USER=sio_commercial_relationship
COMMERCIAL_RELATIONSHIP_DB_PASSWORD=sio_commercial_relationship_dev_change_me
COMMERCIAL_RELATIONSHIP_DB_PORT=55442

COMMERCIAL_RELATIONSHIP_TEST_DB_NAME=sio_commercial_relationship_test
COMMERCIAL_RELATIONSHIP_TEST_DB_USER=sio_commercial_relationship_test
COMMERCIAL_RELATIONSHIP_TEST_DB_PASSWORD=sio_commercial_relationship_test_dev_change_me
COMMERCIAL_RELATIONSHIP_TEST_DB_PORT=55443
COMMERCIAL_RELATIONSHIP_TEST_DATABASE_URL=postgresql+psycopg://sio_commercial_relationship_test:sio_commercial_relationship_test_dev_change_me@127.0.0.1:55443/sio_commercial_relationship_test

DATABASE_URL=postgresql+psycopg://sio_commercial_relationship:sio_commercial_relationship_dev_change_me@127.0.0.1:55442/sio_commercial_relationship


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api


# ============================================================
# PRUEBAS DE INTEGRACIÓN (pytest -m integration)
# ============================================================
# Solo las usa tests/integration contra servicios reales. La contraseña real
# nunca se versiona: se lee de KEYCLOAK_TEST_USER_PASSWORD o de infrastructure/.env.

# Apuntan al entorno integrado (infrastructure/scripts/rebuild-all.sh): la prueba
# crea los datos en los mismos proveedores que usa el contenedor de este servicio.
# El secreto del cliente técnico se lee de COMMERCIAL_RELATIONSHIP_INTEGRATION_CLIENT_SECRET
# o de infrastructure/.env (conftest.py fija COMMERCIAL_RELATIONSHIP_CLIENT_SECRET de prueba).
COMMERCIAL_RELATIONSHIP_INTEGRATION_BASE_URL=http://localhost:8106
OPERATIONAL_CONTEXT_INTEGRATION_BASE_URL=http://localhost:8104/api/v1
PRODUCT_CATALOG_INTEGRATION_BASE_URL=http://localhost:8103/api/v1
PARTY_IDENTITY_INTEGRATION_BASE_URL=http://localhost:8101/api/v1
GEOGRAPHY_INTEGRATION_BASE_URL=http://localhost:8102
KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/sio/protocol/openid-connect/token

# ============================================================
# PUERTOS DE OTROS COMPONENTES (ver docs/port-map.md)
# ============================================================
# Puerto de host de cada proveedor en SU entorno independiente; el compose los
# usa para alcanzarlos vía host.docker.internal.
KEYCLOAK_HTTP_PORT=8081
OPERATIONAL_CONTEXT_SERVICE_PORT=8004
PRODUCT_CATALOG_SERVICE_PORT=8003
PARTY_IDENTITY_SERVICE_PORT=8002
