# ============================================================
# COMMERCIAL RELATIONSHIP SERVICE — despliegue en la VPS
# ============================================================
# Plantilla de services/commercial-relationship-service/.env.vps (no versionado: .gitignore y .dockerignore).
# Copie este archivo a .env.vps en esta misma carpeta y reemplace cada CHANGE_ME.
# Lo usa services/commercial-relationship-service/docker-compose.vps.yml como env_file de la API y de:
#   commercial-relationship-audit-outbox-worker
#   commercial-relationship-price-worker
# Escriba valores literales. Compose interpreta $ en este archivo: si un valor (p. ej. una
# contraseña) contiene $, enciérrelo entre comillas simples: CLAVE='valor$con$dolar'.
# Ninguna imagen ejecuta migraciones ni seeds al arrancar.


# ============================================================
# DOCKER COMPOSE (interpolación: --env-file services/commercial-relationship-service/.env.vps)
# ============================================================
# Tag de la imagen local y puerto del host (docs/port-map.md; no cambiarlo).

SIO_SERVICES_VERSION=0.1.0
COMMERCIAL_RELATIONSHIP_SERVICE_PORT=8106


# ============================================================
# POSTGRESQL (contenedor existente sio-postgres-18 en sio-network)
# ============================================================
# Puerto interno 5432; base y usuario propios del microservicio. Si la contraseña tiene
# caracteres reservados de URL (@ : / ? # % &), escríbala codificada (p. ej. @ -> %40).

DATABASE_URL=postgresql+psycopg://commercial_relationship_user:CHANGE_ME@sio-postgres-18:5432/commercial_relationship


# ============================================================
# SIO AUTH (Keycloak)
# ============================================================
# El issuer es la URL PÚBLICA de Keycloak: debe coincidir exactamente con el claim iss de los
# tokens. Las llaves (JWKS) también se obtienen por la URL pública de Keycloak.

SIO_AUTH_ISSUER=https://auth.2.25.76.203.sslip.io/realms/sio
SIO_AUTH_JWKS_URL=https://auth.2.25.76.203.sslip.io/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api
# Producción: sin Swagger UI ni /openapi.json públicos.
SIO_DOCS_ENABLED=false


# ============================================================
# DEPENDENCIAS
# ============================================================
# Todas con /api/v1, salvo Payment Reference.

OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://operational-context-service:8000/api/v1
OPERATIONAL_CONTEXT_TIMEOUT_SECONDS=5
PRODUCT_CATALOG_SERVICE_BASE_URL=http://product-catalog-service:8000/api/v1
PRODUCT_CATALOG_TIMEOUT_SECONDS=5
PARTY_IDENTITY_SERVICE_BASE_URL=http://party-identity-service:8000/api/v1
PARTY_IDENTITY_TIMEOUT_SECONDS=5
PAYMENT_REFERENCE_SERVICE_BASE_URL=http://payment-reference-service:8000
PAYMENT_REFERENCE_TIMEOUT_SECONDS=5


# ============================================================
# IDENTIDAD TÉCNICA (client_credentials)
# ============================================================
# Cliente "commercial-relationship-service" del realm. Mismo secreto que AUDIT_CLIENT_SECRET.
# KEYCLOAK_BASE_URL y KEYCLOAK_REALM los usan también el audit-outbox-worker.

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=sio
COMMERCIAL_RELATIONSHIP_CLIENT_ID=commercial-relationship-service
COMMERCIAL_RELATIONSHIP_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_TIMEOUT_SECONDS=5


# ============================================================
# COMMERCIAL-RELATIONSHIP-PRICE-WORKER (spec 021)
# ============================================================
# Procesa las aplicaciones de precios automáticos; solo usa su base.

CR_PRICE_WORKER_INTERVAL_SECONDS=5
CR_PRICE_WORKER_BATCH_SIZE=50
CR_PRICE_WORKER_MAX_BACKOFF_SECONDS=300


# ============================================================
# COMMERCIAL-RELATIONSHIP-AUDIT-OUTBOX-WORKER (python -m sio_audit.worker)
# ============================================================
# Misma base (DATABASE_URL) y mismo cliente técnico del servicio: AUDIT_CLIENT_SECRET
# lleva el mismo valor que el secreto del cliente de arriba.

AUDIT_SERVICE_BASE_URL=http://audit-service:8000/api/v1
# KEYCLOAK_BASE_URL: definida arriba (la comparten la API y el worker).
# KEYCLOAK_REALM: definida arriba (la comparten la API y el worker).
AUDIT_CLIENT_ID=commercial-relationship-service
AUDIT_CLIENT_SECRET=CHANGE_ME
AUDIT_OUTBOX_POLL_INTERVAL_SECONDS=2
AUDIT_OUTBOX_HTTP_TIMEOUT_SECONDS=5
AUDIT_OUTBOX_BACKOFF_INITIAL_SECONDS=1
AUDIT_OUTBOX_BACKOFF_FACTOR=2
AUDIT_OUTBOX_BACKOFF_MAX_SECONDS=300
AUDIT_OUTBOX_BATCH_SIZE=100
