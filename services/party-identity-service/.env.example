# ============================================================
# PARTY IDENTITY SERVICE
# ============================================================

SIO_DOCS_ENABLED=true
PARTY_IDENTITY_SERVICE_PORT=8002

# URL base de Geography Service, incluido su prefijo de ruta vigente
# (hoy Geography publica sus rutas sin /api/v1).
GEOGRAPHY_SERVICE_BASE_URL=http://localhost:8000
GEOGRAPHY_TIMEOUT_SECONDS=5


# ============================================================
# DATOS INICIALES (seed)
# ============================================================

# Modo país explícito: UUID de Colombia en el Geography de tu entorno.
# Vacío: el seed resuelve el país COL consultando Geography.
PARTY_IDENTITY_SEED_COUNTRY_ID=

# Identidad técnica del servicio (client_credentials) usada solo por el
# seed en modo Geography. El secreto real nunca se versiona.
KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/sio/protocol/openid-connect/token
KEYCLOAK_TIMEOUT_SECONDS=5
PARTY_IDENTITY_CLIENT_ID=party-identity-service
PARTY_IDENTITY_CLIENT_SECRET=change_me_party_identity_client_secret


# ============================================================
# POSTGRESQL
# ============================================================

PARTY_IDENTITY_DB_NAME=sio_party_identity
PARTY_IDENTITY_DB_USER=sio_party_identity
PARTY_IDENTITY_DB_PASSWORD=sio_party_identity_dev_change_me
PARTY_IDENTITY_DB_PORT=55435

PARTY_IDENTITY_TEST_DB_NAME=sio_party_identity_test
PARTY_IDENTITY_TEST_DB_USER=sio_party_identity_test
PARTY_IDENTITY_TEST_DB_PASSWORD=sio_party_identity_test_dev_change_me
PARTY_IDENTITY_TEST_DB_PORT=55436
PARTY_IDENTITY_TEST_DATABASE_URL=postgresql+psycopg://sio_party_identity_test:sio_party_identity_test_dev_change_me@127.0.0.1:55436/sio_party_identity_test

DATABASE_URL=postgresql+psycopg://sio_party_identity:sio_party_identity_dev_change_me@127.0.0.1:55435/sio_party_identity


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api
