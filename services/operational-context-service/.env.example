# ============================================================
# OPERATIONAL CONTEXT SERVICE
# ============================================================
# Un único comportamiento funcional en todos los entornos: no existen
# variables de "modo" (stub, fake, test) para las dependencias (R-12).

SIO_DOCS_ENABLED=true
OPERATIONAL_CONTEXT_SERVICE_PORT=8004

# URL base de Party Identity Service; INCLUYE el prefijo /api/v1.
PARTY_IDENTITY_SERVICE_BASE_URL=http://localhost:8002/api/v1
PARTY_IDENTITY_TIMEOUT_SECONDS=5

# URL base de Geography Service, incluido su prefijo de ruta vigente
# (hoy Geography publica sus rutas sin /api/v1, GAP-003 diferido).
GEOGRAPHY_SERVICE_BASE_URL=http://localhost:8000
GEOGRAPHY_TIMEOUT_SECONDS=5

# Keycloak Admin API de solo lectura con el cliente técnico propio
# operational-context-service (client_credentials, view-users y query-clients).
# Se usa para verificar cuentas al registrar usuarios operativos y para leer los
# permisos efectivos de un usuario en la comprobación técnica de acceso.
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=sio
OPERATIONAL_CONTEXT_CLIENT_ID=operational-context-service
# Solo en .env, nunca versionado. Debe coincidir con el secreto del realm.
OPERATIONAL_CONTEXT_CLIENT_SECRET=change-this-operational-context-client-secret
KEYCLOAK_TIMEOUT_SECONDS=5
SIO_API_CLIENT_ID=sio-api


# ============================================================
# POSTGRESQL
# ============================================================

OPERATIONAL_CONTEXT_DB_NAME=sio_operational_context
OPERATIONAL_CONTEXT_DB_USER=sio_operational_context
OPERATIONAL_CONTEXT_DB_PASSWORD=sio_operational_context_dev_change_me
OPERATIONAL_CONTEXT_DB_PORT=55439

OPERATIONAL_CONTEXT_TEST_DB_NAME=sio_operational_context_test
OPERATIONAL_CONTEXT_TEST_DB_USER=sio_operational_context_test
OPERATIONAL_CONTEXT_TEST_DB_PASSWORD=sio_operational_context_test_dev_change_me
OPERATIONAL_CONTEXT_TEST_DB_PORT=55440
OPERATIONAL_CONTEXT_TEST_DATABASE_URL=postgresql+psycopg://sio_operational_context_test:sio_operational_context_test_dev_change_me@127.0.0.1:55440/sio_operational_context_test

DATABASE_URL=postgresql+psycopg://sio_operational_context:sio_operational_context_dev_change_me@127.0.0.1:55439/sio_operational_context


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api


# ============================================================
# PRUEBAS DE INTEGRACIÓN (pytest -m integration)
# ============================================================
# Solo las usa tests/integration contra servicios reales. La contraseña real
# nunca se versiona: se lee de KEYCLOAK_TEST_USER_PASSWORD o de infrastructure/.env.

OPERATIONAL_CONTEXT_INTEGRATION_BASE_URL=http://localhost:8004
KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/sio/protocol/openid-connect/token

# ============================================================
# PUERTOS DE OTROS COMPONENTES (ver docs/port-map.md)
# ============================================================
# Puerto de host de cada proveedor en SU entorno independiente; el compose los
# usa para alcanzarlos vía host.docker.internal. Deben coincidir con el .env
# de cada proveedor (y KEYCLOAK_HTTP_PORT con infrastructure/.env).
KEYCLOAK_HTTP_PORT=8081
GEOGRAPHY_SERVICE_PORT=8000
PARTY_IDENTITY_SERVICE_PORT=8002
