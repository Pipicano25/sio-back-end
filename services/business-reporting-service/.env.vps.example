# ============================================================
# BUSINESS REPORTING SERVICE — despliegue en la VPS
# ============================================================
# Plantilla de services/business-reporting-service/.env.vps (no versionado: .gitignore y .dockerignore).
# Copie este archivo a .env.vps en esta misma carpeta y reemplace cada CHANGE_ME.
# Lo usa services/business-reporting-service/docker-compose.vps.yml como env_file de la API.
# Escriba valores literales. Compose interpreta $ en este archivo: si un valor (p. ej. una
# contraseña) contiene $, enciérrelo entre comillas simples: CLAVE='valor$con$dolar'.
# Ninguna imagen ejecuta migraciones ni seeds al arrancar.


# ============================================================
# DOCKER COMPOSE (interpolación: --env-file services/business-reporting-service/.env.vps)
# ============================================================
# Tag de la imagen local y puerto del host (docs/port-map.md; no cambiarlo).

SIO_SERVICES_VERSION=0.1.0
BUSINESS_REPORTING_SERVICE_PORT=8113


# ============================================================
# SIO AUTH (Keycloak)
# ============================================================
# El issuer es la URL PÚBLICA de Keycloak: debe coincidir exactamente con el claim iss de los
# tokens. Las llaves (JWKS) también se obtienen por la URL pública de Keycloak.

SIO_AUTH_ISSUER=https://auth.2.25.76.203.sslip.io/realms/sio
SIO_AUTH_JWKS_URL=https://auth.2.25.76.203.sslip.io/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api
# Producción: sin Swagger UI ni /openapi.json públicos.
SIO_DOCS_ENABLED=false


# ============================================================
# DEPENDENCIAS
# ============================================================
# Todas con /api/v1. Sin cliente técnico: consulta con el token del usuario.
# Sin dependencia de arranque: si un propietario no está disponible, el reporte responde 503.

OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://operational-context-service:8000/api/v1
SALES_SERVICE_BASE_URL=http://sales-service:8000/api/v1
PURCHASE_SERVICE_BASE_URL=http://purchase-service:8000/api/v1
INVENTORY_SERVICE_BASE_URL=http://inventory-service:8000/api/v1
COMMERCIAL_RELATIONSHIP_SERVICE_BASE_URL=http://commercial-relationship-service:8000/api/v1
PRODUCT_CATALOG_SERVICE_BASE_URL=http://product-catalog-service:8000/api/v1


# ============================================================
# LÍMITES DE LOS REPORTES
# ============================================================
# Valores del entorno integrado (spec 023).

BRS_DEPENDENCY_TIMEOUT_SECONDS=5
BRS_JSON_BUDGET_SECONDS=10
BRS_CSV_BUDGET_SECONDS=120
BRS_MAX_PARALLEL_CALLS=4
BRS_MAX_PERIOD_DAYS=366
BRS_CSV_MAX_ROWS=50000
BRS_DEFAULT_TIMEZONE=America/Bogota
