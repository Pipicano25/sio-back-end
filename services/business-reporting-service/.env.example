# business-reporting-service: variables de entorno (spec 023).
# Copiar a .env para desarrollo local. No hay secretos propios: el servicio no tiene cliente técnico (DR-07).

# --- sio-auth (Keycloak) ---
SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api
# /docs y /openapi.json solo públicos cuando está habilitado (Principio V).
SIO_DOCS_ENABLED=true

# --- Dependencias, todas con el token del usuario (las URL incluyen /api/v1; Principio XV) ---
OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://localhost:8104/api/v1
SALES_SERVICE_BASE_URL=http://localhost:8108/api/v1
PURCHASE_SERVICE_BASE_URL=http://localhost:8107/api/v1
INVENTORY_SERVICE_BASE_URL=http://localhost:8109/api/v1
COMMERCIAL_RELATIONSHIP_SERVICE_BASE_URL=http://localhost:8106/api/v1
PRODUCT_CATALOG_SERVICE_BASE_URL=http://localhost:8103/api/v1

# --- Tiempos y límites (FR-023-50 a FR-023-52; DR-09) ---
BRS_DEPENDENCY_TIMEOUT_SECONDS=5
BRS_JSON_BUDGET_SECONDS=10
BRS_CSV_BUDGET_SECONDS=120
BRS_MAX_PARALLEL_CALLS=4
BRS_MAX_PERIOD_DAYS=366
BRS_CSV_MAX_ROWS=50000
BRS_DEFAULT_TIMEZONE=America/Bogota
