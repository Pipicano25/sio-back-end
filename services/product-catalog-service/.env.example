# ============================================================
# PRODUCT CATALOG SERVICE
# ============================================================

SIO_DOCS_ENABLED=true
PRODUCT_CATALOG_SERVICE_PORT=8003

# Party Identity Service (validación del fabricante). La URL incluye el
# prefijo de ruta del proveedor.
PARTY_IDENTITY_SERVICE_BASE_URL=http://localhost:8002/api/v1
PARTY_IDENTITY_TIMEOUT_SECONDS=3


# ============================================================
# POSTGRESQL
# ============================================================

PRODUCT_CATALOG_DB_NAME=sio_product_catalog
PRODUCT_CATALOG_DB_USER=sio_product_catalog
PRODUCT_CATALOG_DB_PASSWORD=sio_product_catalog_dev_change_me
PRODUCT_CATALOG_DB_PORT=55437

PRODUCT_CATALOG_TEST_DB_NAME=sio_product_catalog_test
PRODUCT_CATALOG_TEST_DB_USER=sio_product_catalog_test
PRODUCT_CATALOG_TEST_DB_PASSWORD=sio_product_catalog_test_dev_change_me
PRODUCT_CATALOG_TEST_DB_PORT=55438
PRODUCT_CATALOG_TEST_DATABASE_URL=postgresql+psycopg://sio_product_catalog_test:sio_product_catalog_test_dev_change_me@127.0.0.1:55438/sio_product_catalog_test

DATABASE_URL=postgresql+psycopg://sio_product_catalog:sio_product_catalog_dev_change_me@127.0.0.1:55437/sio_product_catalog


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api

# ============================================================
# PUERTOS DE OTROS COMPONENTES (ver docs/port-map.md)
# ============================================================
# Puerto de host de cada proveedor en SU entorno independiente; el compose los
# usa para alcanzarlos vía host.docker.internal. Deben coincidir con el .env
# de cada proveedor (y KEYCLOAK_HTTP_PORT con infrastructure/.env).
KEYCLOAK_HTTP_PORT=8081
PARTY_IDENTITY_SERVICE_PORT=8002
