# ============================================================
# PRODUCT CATALOG SERVICE
# ============================================================

SIO_DOCS_ENABLED=true

# Party Identity Service (validación del fabricante). La URL incluye el
# prefijo de ruta del proveedor.
PARTY_IDENTITY_SERVICE_BASE_URL=http://localhost:8101/api/v1
PARTY_IDENTITY_TIMEOUT_SECONDS=3


# ============================================================
# POSTGRESQL
# ============================================================
# Base y base de pruebas del proyecto compose "product-catalog-service"
# (infrastructure/services/product-catalog-service.yaml); sus credenciales y puertos se
# definen en infrastructure/.env (docs/port-map.md). Base de pruebas:
#   docker compose --file ../../infrastructure/services/product-catalog-service.yaml --env-file ../../infrastructure/.env --profile test up -d product-catalog-test-db

PRODUCT_CATALOG_TEST_DATABASE_URL=postgresql+psycopg://sio_product_catalog_test:sio_product_catalog_test_dev_change_me@127.0.0.1:55438/sio_product_catalog_test

DATABASE_URL=postgresql+psycopg://product_catalog_user:change-this-product-catalog-database-password@127.0.0.1:5444/product_catalog


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api
