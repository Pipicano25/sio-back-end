# ============================================================
# AUDIT SERVICE
# ============================================================
# Un único comportamiento funcional en todos los entornos: no existen
# variables de "modo" (stub, fake, test) para las dependencias.

SIO_DOCS_ENABLED=true

# Operational Context: membresía del usuario en la empresa consultada
# (`operational-access`, vía propia, con el token del usuario; FR-050).
# La URL base INCLUYE el prefijo /api/v1.
OPERATIONAL_CONTEXT_SERVICE_BASE_URL=http://localhost:8104/api/v1
OPERATIONAL_CONTEXT_TIMEOUT_SECONDS=5

# Tolerancia de `occurred_at` hacia el futuro respecto de la hora de la base (DS-08).
AUDIT_MAX_CLOCK_SKEW_SECONDS=300


# ============================================================
# POSTGRESQL
# ============================================================
# Base y base de pruebas del proyecto compose "audit-service"
# (infrastructure/services/audit-service.yaml); sus credenciales y puertos se
# definen en infrastructure/.env (docs/port-map.md). Base de pruebas:
#   docker compose --file ../../infrastructure/services/audit-service.yaml --env-file ../../infrastructure/.env --profile test up -d audit-test-db

AUDIT_TEST_DATABASE_URL=postgresql+psycopg://sio_audit_test:sio_audit_test_dev_change_me@127.0.0.1:55451/sio_audit_test

DATABASE_URL=postgresql+psycopg://audit_user:change-this-audit-database-password@127.0.0.1:5449/audit


# ============================================================
# SIO AUTH
# ============================================================

SIO_AUTH_ISSUER=http://localhost:8081/realms/sio
SIO_AUTH_JWKS_URL=http://localhost:8081/realms/sio/protocol/openid-connect/certs
SIO_AUTH_AUDIENCE=sio-api


# ============================================================
# PRUEBAS DE INTEGRACIÓN (pytest -m integration)
# ============================================================
# Solo las usa tests/integration contra servicios reales del entorno integrado.
# Las contraseñas y secretos reales nunca se versionan: se leen de
# KEYCLOAK_TEST_USER_PASSWORD y AUDIT_TEST_EMITTER_CLIENT_SECRET o de infrastructure/.env.
AUDIT_INTEGRATION_BASE_URL=http://localhost:8110/api/v1
OPERATIONAL_CONTEXT_INTEGRATION_BASE_URL=http://localhost:8104/api/v1
KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/sio/protocol/openid-connect/token
AUDIT_TEST_EMITTER_CLIENT_ID=audit-test-emitter
